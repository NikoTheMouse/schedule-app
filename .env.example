# MouseTime — Supabase configuration
# Copy this file to .env.local in apps/web/ and fill in values from your Supabase project dashboard.
# Source: supabase.com/docs/guides/auth/server-side/nextjs

# Public Supabase project URL — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public anon key — designed for client-side use; respects Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ⚠ SECURITY: The service role key bypasses Row Level Security.
# NEVER prefix it with NEXT_PUBLIC_ and NEVER commit it to version control.
# Only set this in server-side environments (e.g. CI, server runtime) when an admin operation requires it.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
